{
  "name": "domain-glossary-mcp",
  "version": "0.1.0",
  "description": "MCP server that stores and serves business definitions of domain terms, backed by SQLite",
  "type": "module",
  "bin": {
    "domain-glossary-mcp": "dist/src/index.js"
  },
  "main": "dist/src/server.js",
  "files": [
    "dist/src",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/index.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "env-paths": "4.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.1",
    "typescript": "7.0.2"
  },
  "keywords": [
    "mcp",
    "glossary",
    "domain-driven-design",
    "sqlite"
  ],
  "author": "Matheus Lubarino <matheus.lubarino1@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lubarinobr/domain-glossary-mcp.git"
  },
  "homepage": "https://github.com/lubarinobr/domain-glossary-mcp#readme",
  "bugs": {
    "url": "https://github.com/lubarinobr/domain-glossary-mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
